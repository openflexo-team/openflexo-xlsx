// Perform some initialization, display resources and the context
service ResourceCenterService status;
resources;
context;

// Load TestFMLReflect virtual model
virtualModel = load -r ["http://www.openflexo.org/excel-test/FML/ReflectPersonListing.fml"];
context;
assert virtualModel != null;
log "Pretty-print of "+virtualModel;
log virtualModel.fMLPrettyPrint;
//validate virtualModel;

// Load resources beeing used in this use case
listing = load -r ["http://www.openflexo.org/excel-test/TestResourceCenter/Excel/PersonListing.xls"];
log "listing="+listing;
assert listing != null;

// Instantiate TestFMLReflect
service ResourceCenterService add_temp_rc;
myVMI = new ReflectPersonListing(listing.resource) with (name="testReflect1");
context;
assert myVMI != null;

// Each significative row of the data range is reflected as a Person
listingVMI = myVMI.personListing;
assert listingVMI != null;
assert listingVMI.flexoConceptInstances.size() == 6;
person1 = listingVMI.flexoConceptInstances.get(0);
log "person1="+person1;
assert person1.genre == "MR";
assert person1.name == "Jean Dupont";
assert person1.activity == "Architect";
assert person1.age == 45;
assert person1.city == "BREST";
person6 = listingVMI.flexoConceptInstances.get(5);
log "person6="+person6;
assert person6.name == "Alain Terrieur";
assert person6.age == 55;
assert person6.city == "MULHOUSE";

